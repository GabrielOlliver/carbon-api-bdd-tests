{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Indicadores de sustentabilidade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "totalEmpresas",
    "totalEmissoes",
    "totalTco2eEmitido",
    "totalAgendamentos",
    "agendamentosConcluidos",
    "totalTco2eCompensado",
    "saldoLiquidoTco2e"
  ],
  "properties": {
    "totalEmpresas": {
      "type": "integer",
      "minimum": 0
    },
    "totalEmissoes": {
      "type": "integer",
      "minimum": 0
    },
    "totalTco2eEmitido": {
      "type": "number"
    },
    "totalAgendamentos": {
      "type": "integer",
      "minimum": 0
    },
    "agendamentosConcluidos": {
      "type": "integer",
      "minimum": 0
    },
    "totalTco2eCompensado": {
      "type": "number"
    },
    "saldoLiquidoTco2e": {
      "type": "number"
    }
  }
}
